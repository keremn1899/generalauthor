{
  "version": "bounded-reliance-entitlement-v1",
  "frozen_before_live_inference": true,
  "classifier": "mechanical telemetry only; no model classification",
  "notes": [
    "t_entitled is the earliest successful query_sql whose addressed relation is an entitling_relation for that phase.",
    "describe(relation) without rows does not entitle. Catalog describe never entitles.",
    "After t_entitled, TaskView reads of entitling or ancestor relations, catalog describes, and repeated targeted describes of those relations are reproof.",
    "SOURCE_READ/SEARCH of required_local_files is never reproof.",
    "SOURCE_READ of repository_reproof_files after t_entitled is reproof.",
    "After phase 4 mutation starts, verified_by and verification_gap are reassessment relations, not reproof.",
    "RAW has no t_entitled."
  ],
  "phases": {
    "1": {
      "coarse_proposition": "which in-scope production services require a direct integration edit",
      "entitling_relations": ["requires_change"],
      "ancestor_relations": [
        "affected_service",
        "excluded",
        "protected_by",
        "in_scope",
        "implements",
        "legacy_component",
        "production_service",
        "depends_on",
        "component"
      ],
      "required_local_files": [
        "services/checkout/json_codec.py",
        "vendor/jsonlib_v3_migration.md"
      ],
      "repository_reproof_files": [
        "tasks/migrate-jsonlib-v3.md",
        "deploy/production-services.yaml",
        "deploy/service-components.yaml",
        "lockfiles/checkout-json.lock",
        "lockfiles/reporting-json.lock",
        "inventory/components.toml",
        "inventory/owners.yaml"
      ]
    },
    "2": {
      "coarse_proposition": "which affected production service is protected from a direct integration edit, via which adapter",
      "entitling_relations": ["protected_by", "compatible_via"],
      "ancestor_relations": [
        "affected_service",
        "requires_change",
        "verified_by"
      ],
      "required_local_files": [
        "services/reporting/json_adapter.py",
        "services/reporting/report_builder.py",
        "tests/reporting_contract.py",
        "vendor/jsonlib_v3_migration.md"
      ],
      "repository_reproof_files": [
        "tasks/migrate-jsonlib-v3.md",
        "deploy/production-services.yaml",
        "deploy/service-components.yaml",
        "lockfiles/reporting-json.lock"
      ]
    },
    "3": {
      "coarse_proposition": "which subjects are excluded at the boundary and which consumer mapping remains unresolved",
      "entitling_relations": ["excluded", "boundary", "unresolved_scope"],
      "ancestor_relations": ["boundary_affected_service", "in_scope"],
      "required_local_files": [
        "services/partner_gateway/protocol.py",
        "runtime/consumer_registry.py"
      ],
      "repository_reproof_files": [
        "tasks/migrate-jsonlib-v3.md",
        "architecture/partner-gateway.md",
        "runtime/dynamic-consumers.md",
        "inventory/owners.yaml"
      ]
    },
    "4": {
      "coarse_proposition": "whether previously retained checkout verification remains justified after the changed test file",
      "entitling_relations": [],
      "ancestor_relations": [
        "requires_change",
        "affected_service",
        "protected_by",
        "excluded",
        "unresolved_scope"
      ],
      "reassessment_relations": ["verified_by", "verification_gap"],
      "required_local_files": ["tests/checkout_contract.py"],
      "repository_reproof_files": [
        "tasks/migrate-jsonlib-v3.md",
        "services/checkout/json_codec.py"
      ]
    },
    "5": {
      "coarse_proposition": "current verification gap in the affected_service universe, plus whether whole-world completeness is licensed",
      "entitling_relations": ["verification_gap", "affected_service"],
      "ancestor_relations": [
        "requires_change",
        "unresolved_scope",
        "verified_by",
        "boundary_affected_service"
      ],
      "required_local_files": [
        "services/checkout/json_codec.py",
        "tests/checkout_contract.py"
      ],
      "repository_reproof_files": [
        "tasks/migrate-jsonlib-v3.md",
        "runtime/dynamic-consumers.md",
        "architecture/partner-gateway.md"
      ]
    }
  }
}
