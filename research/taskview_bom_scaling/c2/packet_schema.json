{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "taskview-bom-c2-packet-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_assertion",
    "relevant_referents",
    "known_mechanical_facts",
    "evidence",
    "conflicts",
    "missing_information"
  ],
  "properties": {
    "candidate_assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation", "tuple"],
      "properties": {
        "relation": {"const": "acceptable_replacement"},
        "tuple": {
          "type": "array",
          "prefixItems": [
            {"type": "string"},
            {"type": "string"},
            {"type": "string"}
          ],
          "items": false
        }
      }
    },
    "relevant_referents": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "string"}
    },
    "known_mechanical_facts": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {"type": "array"}
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "source_fingerprint",
          "native_location",
          "record"
        ],
        "properties": {
          "source": {"type": "string"},
          "source_fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "native_location": {"type": "string"},
          "record": {"type": "string"}
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {"type": "array"}
    },
    "missing_information": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
