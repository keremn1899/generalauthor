{"event": "sql_statement", "query_text": "\nWITH RECURSIVE affected(module_id) AS (\n  SELECT subject_id FROM module_depends_on_package WHERE object_id = 'package:fx04-legacy'\n  UNION\n  SELECT m.subject_id\n  FROM module_depends_on_module m\n  JOIN affected a ON m.object_id = a.module_id\n)\nSELECT m.id FROM modules m WHERE m.id LIKE 'module:fx04-l5-%' AND m.id NOT IN (SELECT module_id FROM affected)\n", "parameters": "()", "order": 1788084286557033227}
{"event": "sql_statement", "query_text": "\nWITH RECURSIVE pkg_modules(module_id) AS (\n  SELECT subject_id FROM module_depends_on_package WHERE object_id = 'package:fx04-legacy'\n  UNION\n  SELECT m.object_id\n  FROM module_depends_on_module m\n  JOIN pkg_modules p ON m.subject_id = p.module_id\n)\nSELECT module_id FROM pkg_modules WHERE module_id LIKE 'module:fx04-l5-%'\n", "parameters": "()", "order": 1788084286557463223}
