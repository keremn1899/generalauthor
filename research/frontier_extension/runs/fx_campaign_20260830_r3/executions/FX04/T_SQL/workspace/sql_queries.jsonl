{"event": "sql_statement", "query_text": "\nWITH RECURSIVE affected(module_id) AS (\n  SELECT subject_id FROM module_depends_on_package WHERE object_id = 'package:fx04-legacy'\n  UNION\n  SELECT m.subject_id\n  FROM module_depends_on_module m\n  JOIN affected a ON m.object_id = a.module_id\n)\nSELECT DISTINCT s.id\nFROM services s\nJOIN service_implements_module sim ON sim.subject_id = s.id\nJOIN affected a ON a.module_id = sim.object_id\nJOIN service_deployed_to_deployment sd ON sd.subject_id = s.id\nJOIN task_targets_deployment ttd ON ttd.object_id = sd.object_id AND ttd.subject_id = 'task:fx04-cutover'\nLEFT JOIN service_crosses_deprecated_boundary scdb ON scdb.subject_id = s.id\nWHERE scdb.subject_id IS NULL\nORDER BY s.id\n", "parameters": "()", "order": 1788084281605453586}
{"event": "sql_statement", "query_text": "\nWITH RECURSIVE affected(module_id) AS (\n  SELECT subject_id FROM module_depends_on_package WHERE object_id = 'package:fx04-legacy'\n  UNION\n  SELECT m.subject_id\n  FROM module_depends_on_module m\n  JOIN affected a ON m.object_id = a.module_id\n)\nSELECT DISTINCT s.id\nFROM services s\nJOIN service_implements_module sim ON sim.subject_id = s.id\nJOIN affected a ON a.module_id = sim.object_id\nJOIN service_deployed_to_deployment sd ON sd.subject_id = s.id\nJOIN migration_targets_deployment mtd ON mtd.object_id = sd.object_id\nJOIN package_affects_migration pam ON pam.object_id = mtd.subject_id AND pam.subject_id = 'package:fx04-legacy'\nLEFT JOIN service_crosses_deprecated_boundary scdb ON scdb.subject_id = s.id\nWHERE scdb.subject_id IS NULL\nORDER BY s.id\n", "parameters": "()", "order": 1788084281605829003}
