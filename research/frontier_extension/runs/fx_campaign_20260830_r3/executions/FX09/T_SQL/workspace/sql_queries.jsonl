{"event": "sql_statement", "query_text": "\nWITH RECURSIVE package_modules AS (\n  SELECT subject_id AS module_id\n  FROM module_depends_on_package\n  WHERE object_id = 'package:fx09-legacy'\n),\naffected_modules AS (\n  SELECT module_id FROM package_modules\n  UNION\n  SELECT m.subject_id\n  FROM module_depends_on_module m\n  JOIN affected_modules a ON m.object_id = a.module_id\n)\nSELECT DISTINCT sim.subject_id AS service_id\nFROM service_implements_module sim\nJOIN affected_modules am ON sim.object_id = am.module_id\nJOIN service_deployed_to_deployment sdd ON sdd.subject_id = sim.subject_id\nWHERE sdd.object_id = 'deployment:fx09-production'\nORDER BY service_id;\n", "parameters": "()", "order": 1788085326409857733}
{"event": "sql_statement", "query_text": "\n      SELECT DISTINCT object_id FROM service_owned_by_team\n      WHERE subject_id IN (?,?,?,?,?,?)\n      ORDER BY object_id\n    ", "parameters": "['service:fx09-00', 'service:fx09-01', 'service:fx09-02', 'service:fx09-03', 'service:fx09-04', 'service:fx09-05']", "order": 1788085326411076205}
{"event": "sql_statement", "query_text": "\n  SELECT DISTINCT sdd.object_id\n  FROM service_deployed_to_deployment sdd\n  WHERE sdd.subject_id IN (?,?,?,?,?,?)\n  ORDER BY sdd.object_id\n", "parameters": "['service:fx09-00', 'service:fx09-01', 'service:fx09-02', 'service:fx09-03', 'service:fx09-04', 'service:fx09-05']", "order": 1788085326411217320}
