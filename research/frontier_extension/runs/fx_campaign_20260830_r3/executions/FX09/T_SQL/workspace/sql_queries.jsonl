{"event": "sql_statement", "query_text": "\n    WITH RECURSIVE package_modules AS (\n      SELECT subject_id AS module_id FROM module_depends_on_package WHERE object_id = 'package:fx09-legacy'\n    ),\n    chain AS (\n      SELECT ? AS module_id, 0 AS depth\n      UNION ALL\n      SELECT m.object_id, c.depth + 1\n      FROM chain c\n      JOIN module_depends_on_module m ON m.subject_id = c.module_id\n      WHERE c.depth < 20\n    )\n    SELECT MIN(depth) FROM chain c\n    JOIN package_modules p ON c.module_id = p.module_id\n    ", "parameters": "('module:fx09-l8-000',)", "order": 1788085330644081740}
