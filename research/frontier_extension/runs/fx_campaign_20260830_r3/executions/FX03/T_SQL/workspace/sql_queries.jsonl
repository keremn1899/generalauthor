{"event": "sql_statement", "query_text": "\nWITH RECURSIVE package_modules AS (\n  SELECT subject_id AS module_id\n  FROM module_depends_on_package\n  WHERE object_id = 'package:fx03-legacy'\n  UNION\n  SELECT mdm.subject_id\n  FROM module_depends_on_module mdm\n  JOIN package_modules pm ON mdm.object_id = pm.module_id\n)\nSELECT DISTINCT sim.subject_id AS service_id\nFROM service_implements_module sim\nJOIN package_modules pm ON sim.object_id = pm.module_id\nJOIN service_deployed_to_deployment sdd ON sim.subject_id = sdd.subject_id\nJOIN task_targets_deployment ttd ON sdd.object_id = ttd.object_id\nJOIN task_retires_package trp ON trp.subject_id = ttd.subject_id\nWHERE ttd.subject_id = 'task:fx03-cutover'\n  AND trp.object_id = 'package:fx03-legacy'\nORDER BY service_id\n", "parameters": "()", "order": 1788084018329599999}
{"event": "sql_result", "rows_returned": 6, "returned_ids": ["service:fx03-00", "service:fx03-01", "service:fx03-02", "service:fx03-03", "service:fx03-04", "service:fx03-05"], "order": 1788084018330724567}
{"event": "sql_statement", "query_text": "\nWITH RECURSIVE package_modules AS (\n  SELECT subject_id AS module_id\n  FROM module_depends_on_package\n  WHERE object_id = 'package:fx03-legacy'\n  UNION\n  SELECT mdm.subject_id\n  FROM module_depends_on_module mdm\n  JOIN package_modules pm ON mdm.object_id = pm.module_id\n)\nSELECT sim.subject_id AS service_id, sim.object_id AS module_id\nFROM service_implements_module sim\nJOIN package_modules pm ON sim.object_id = pm.module_id\nJOIN service_deployed_to_deployment sdd ON sim.subject_id = sdd.subject_id\nJOIN task_targets_deployment ttd ON sdd.object_id = ttd.object_id\nWHERE ttd.subject_id = 'task:fx03-cutover'\nORDER BY service_id\n", "parameters": "()", "order": 1788084018330817872}
{"event": "sql_statement", "query_text": "\nWITH RECURSIVE package_modules AS (\n  SELECT subject_id AS module_id\n  FROM module_depends_on_package\n  WHERE object_id = 'package:fx03-legacy'\n  UNION\n  SELECT mdm.subject_id\n  FROM module_depends_on_module mdm\n  JOIN package_modules pm ON mdm.object_id = pm.module_id\n),\nproduction_services AS (\n  SELECT sdd.subject_id AS service_id\n  FROM service_deployed_to_deployment sdd\n  JOIN task_targets_deployment ttd ON sdd.object_id = ttd.object_id\n  WHERE ttd.subject_id = 'task:fx03-cutover'\n)\nSELECT ps.service_id,\n       CASE WHEN sim.subject_id IS NOT NULL THEN 'affected' ELSE 'not_affected' END AS status\nFROM production_services ps\nLEFT JOIN service_implements_module sim ON ps.service_id = sim.subject_id\nLEFT JOIN package_modules pm ON sim.object_id = pm.module_id\nGROUP BY ps.service_id\n", "parameters": "()", "order": 1788084020606281879}
{"event": "sql_statement", "query_text": "\nWITH RECURSIVE package_modules AS (\n  SELECT subject_id AS module_id FROM module_depends_on_package WHERE object_id = 'package:fx03-legacy'\n  UNION\n  SELECT mdm.subject_id FROM module_depends_on_module mdm JOIN package_modules pm ON mdm.object_id = pm.module_id\n) SELECT COUNT(*) FROM package_modules", "parameters": "()", "order": 1788084020607494120}
