{"event": "sql_statement", "query_text": "SELECT * FROM modules ORDER BY id", "parameters": "()", "order": 1788083619073088842}
{"event": "sql_statement", "query_text": "\nWITH RECURSIVE module_closure(module_id) AS (\n  -- modules that directly depend on the retired package\n  SELECT subject_id\n  FROM module_depends_on_package\n  WHERE object_id = (\n    SELECT object_id FROM task_retires_package WHERE subject_id = 'task:fx01-cutover'\n  )\n  UNION\n  -- modules that depend on those modules (reverse: find dependents)\n  SELECT mdm.subject_id\n  FROM module_depends_on_module mdm\n  JOIN module_closure mc ON mdm.object_id = mc.module_id\n),\ntarget_deployment AS (\n  SELECT object_id AS deployment_id\n  FROM task_targets_deployment\n  WHERE subject_id = 'task:fx01-cutover'\n)\nSELECT DISTINCT s.id\nFROM services s\nJOIN service_deployed_to_deployment sd ON sd.subject_id = s.id\nJOIN target_deployment td ON sd.object_id = td.deployment_id\nJOIN service_implements_module sim ON sim.subject_id = s.id\nJOIN module_closure mc ON sim.object_id = mc.module_id\nORDER BY s.id\n", "parameters": "()", "order": 1788083624718629800}
{"event": "sql_result", "rows_returned": 6, "returned_ids": ["service:fx01-00", "service:fx01-01", "service:fx01-02", "service:fx01-03", "service:fx01-04", "service:fx01-05"], "order": 1788083624719375464}
{"event": "sql_statement", "query_text": "\nWITH RECURSIVE pkg_deps(module_id) AS (\n  SELECT subject_id FROM module_depends_on_package WHERE object_id = 'package:fx01-legacy'\n  UNION ALL\n  SELECT mdm.subject_id FROM module_depends_on_module mdm\n  JOIN pkg_deps pd ON mdm.object_id = pd.module_id\n)\nSELECT s.id, sim.object_id as module, \n       CASE WHEN sim.object_id IN (SELECT module_id FROM pkg_deps) THEN 1 ELSE 0 END as affected\nFROM services s\nJOIN service_implements_module sim ON sim.subject_id = s.id\nJOIN service_deployed_to_deployment sd ON sd.subject_id = s.id AND sd.object_id = 'deployment:fx01-production'\nORDER BY s.id\n", "parameters": "()", "order": 1788083624719459485}
