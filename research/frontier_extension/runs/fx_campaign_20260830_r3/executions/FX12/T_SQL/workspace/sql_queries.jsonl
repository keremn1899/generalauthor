{"event": "sql_statement", "query_text": "\nWITH RECURSIVE affected_modules(module_id) AS (\n  SELECT subject_id FROM module_depends_on_package WHERE object_id = 'package:fx12-legacy'\n  UNION\n  SELECT mdm.subject_id FROM module_depends_on_module mdm\n  JOIN affected_modules am ON mdm.object_id = am.module_id\n)\nSELECT DISTINCT sim.subject_id\nFROM service_implements_module sim\nJOIN affected_modules am ON sim.object_id = am.module_id\nORDER BY 1\n", "parameters": "()", "order": 1788086493266829984}
{"event": "sql_statement", "query_text": "\nWITH RECURSIVE affected_modules(module_id) AS (\n  SELECT subject_id FROM module_depends_on_package WHERE object_id = 'package:fx12-legacy'\n  UNION\n  SELECT mdm.subject_id FROM module_depends_on_module mdm\n  JOIN affected_modules am ON mdm.object_id = am.module_id\n),\naffected_services AS (\n  SELECT DISTINCT sim.subject_id AS service_id\n  FROM service_implements_module sim\n  JOIN affected_modules am ON sim.object_id = am.module_id\n),\nprod_services AS (\n  SELECT sdd.subject_id AS service_id, sdd.object_id AS deployment_id\n  FROM service_deployed_to_deployment sdd\n  JOIN task_targets_deployment ttd ON ttd.object_id = sdd.object_id\n  JOIN task_retires_package trp ON trp.subject_id = ttd.subject_id\n  WHERE trp.object_id = 'package:fx12-legacy'\n    AND ttd.subject_id = 'task:fx12-cutover'\n)\nSELECT a.service_id, p.deployment_id\nFROM affected_services a\nJOIN prod_services p ON p.service_id = a.service_id\nJOIN service_crosses_boundary scb ON scb.subject_id = a.service_id\nLEFT JOIN test_verifies_service tvs ON tvs.object_id = a.service_id\nWHERE tvs.object_id IS NULL\nORDER BY 1\n", "parameters": "()", "order": 1788086493267313979}
{"event": "sql_statement", "query_text": "\nWITH RECURSIVE affected_modules(module_id) AS (\n  SELECT subject_id FROM module_depends_on_package WHERE object_id = 'package:fx12-legacy'\n  UNION\n  SELECT mdm.subject_id\n  FROM module_depends_on_module mdm\n  JOIN affected_modules am ON mdm.object_id = am.module_id\n),\naffected_services AS (\n  SELECT DISTINCT sim.subject_id AS service_id\n  FROM service_implements_module sim\n  JOIN affected_modules am ON sim.object_id = am.module_id\n)\nSELECT DISTINCT a.service_id\nFROM affected_services a\nJOIN service_deployed_to_deployment sdd ON sdd.subject_id = a.service_id\nJOIN task_targets_deployment ttd\n  ON ttd.object_id = sdd.object_id AND ttd.subject_id = 'task:fx12-cutover'\nJOIN task_retires_package trp\n  ON trp.subject_id = 'task:fx12-cutover' AND trp.object_id = 'package:fx12-legacy'\nJOIN service_crosses_boundary scb ON scb.subject_id = a.service_id\nLEFT JOIN test_verifies_service tvs ON tvs.object_id = a.service_id\nWHERE tvs.object_id IS NULL\nORDER BY a.service_id\n", "parameters": "()", "order": 1788086502552218429}
{"event": "sql_statement", "query_text": "\nWITH RECURSIVE affected_modules(module_id) AS (\n  SELECT subject_id FROM module_depends_on_package WHERE object_id = 'package:fx12-legacy'\n  UNION\n  SELECT mdm.subject_id\n  FROM module_depends_on_module mdm\n  JOIN affected_modules am ON mdm.object_id = am.module_id\n),\naffected_services AS (\n  SELECT DISTINCT sim.subject_id AS service_id\n  FROM service_implements_module sim\n  JOIN affected_modules am ON sim.object_id = am.module_id\n),\nboundary_unverified AS (\n  SELECT DISTINCT a.service_id\n  FROM affected_services a\n  JOIN service_deployed_to_deployment sdd ON sdd.subject_id = a.service_id\n  JOIN task_targets_deployment ttd\n    ON ttd.object_id = sdd.object_id AND ttd.subject_id = 'task:fx12-cutover'\n  JOIN task_retires_package trp\n    ON trp.subject_id = 'task:fx12-cutover' AND trp.object_id = 'package:fx12-legacy'\n  JOIN service_crosses_boundary scb ON scb.subject_id = a.service_id\n  LEFT JOIN test_verifies_service tvs ON tvs.object_id = a.service_id\n  WHERE tvs.object_id IS NULL\n)\nSELECT DISTINCT sdd.object_id\nFROM boundary_unverified bu\nJOIN service_deployed_to_deployment sdd ON sdd.subject_id = bu.service_id\nJOIN task_targets_deployment ttd\n  ON ttd.object_id = sdd.object_id AND ttd.subject_id = 'task:fx12-cutover'\nORDER BY sdd.object_id\n", "parameters": "()", "order": 1788086502553562192}
