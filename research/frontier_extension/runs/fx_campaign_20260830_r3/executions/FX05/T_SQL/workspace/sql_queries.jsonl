{"event": "sql_statement", "query_text": "\nSELECT sim.subject_id, sim.object_id as module_id\nFROM service_implements_module sim\nJOIN service_deployed_to_deployment sdd ON sdd.subject_id = sim.subject_id\nWHERE sdd.object_id = 'deployment:fx05-production'\nORDER BY sim.subject_id\n", "parameters": "()", "order": 1788084321501042827}
{"event": "sql_result", "rows_returned": 6, "returned_ids": ["service:fx05-00", "module:fx05-l8-000", "service:fx05-01", "module:fx05-l8-001", "service:fx05-02", "module:fx05-l8-002", "service:fx05-03", "module:fx05-l8-003", "service:fx05-04", "module:fx05-l8-004", "service:fx05-05", "module:fx05-l8-005"], "order": 1788084321501135617}
{"event": "sql_statement", "query_text": "\nWITH RECURSIVE pkg_deps(module_id) AS (\n  SELECT object_id FROM module_depends_on_package WHERE object_id = 'package:fx05-legacy'\n  UNION\n  SELECT mdm.subject_id\n  FROM module_depends_on_module mdm\n  JOIN pkg_deps pd ON mdm.object_id = pd.module_id\n),\nreverse_deps(module_id) AS (\n  SELECT module_id FROM pkg_deps\n  UNION\n  SELECT mdm.subject_id\n  FROM module_depends_on_module mdm\n  JOIN reverse_deps rd ON mdm.object_id = rd.module_id\n)\nSELECT DISTINCT module_id FROM reverse_deps ORDER BY module_id\n", "parameters": "()", "order": 1788084321501182158}
{"event": "sql_result", "rows_returned": 1, "returned_ids": ["package:fx05-legacy"], "order": 1788084321501473322}
{"event": "sql_statement", "query_text": "\nWITH RECURSIVE pkg_modules(module_id) AS (\n  SELECT subject_id AS module_id FROM module_depends_on_package WHERE object_id = 'package:fx05-legacy'\n  UNION\n  SELECT mdm.subject_id\n  FROM module_depends_on_module mdm\n  JOIN pkg_modules pm ON mdm.object_id = pm.module_id\n)\nSELECT DISTINCT sim.subject_id, sim.object_id\nFROM service_implements_module sim\nJOIN pkg_modules pm ON sim.object_id = pm.module_id\nJOIN service_deployed_to_deployment sdd ON sdd.subject_id = sim.subject_id\nWHERE sdd.object_id = 'deployment:fx05-production'\nORDER BY sim.subject_id\n", "parameters": "()", "order": 1788084321501516896}
{"event": "sql_result", "rows_returned": 6, "returned_ids": ["service:fx05-00", "module:fx05-l8-000", "service:fx05-01", "module:fx05-l8-001", "service:fx05-02", "module:fx05-l8-002", "service:fx05-03", "module:fx05-l8-003", "service:fx05-04", "module:fx05-l8-004", "service:fx05-05", "module:fx05-l8-005"], "order": 1788084321502013197}
{"event": "sql_statement", "query_text": "\nWITH RECURSIVE depends_on_pkg(module_id) AS (\n  SELECT subject_id FROM module_depends_on_package WHERE object_id = 'package:fx05-legacy'\n  UNION\n  SELECT mdm.subject_id\n  FROM module_depends_on_module mdm\n  JOIN depends_on_pkg dop ON mdm.object_id = dop.module_id\n)\nSELECT COUNT(*), MIN(module_id), MAX(module_id) FROM depends_on_pkg\n", "parameters": "()", "order": 1788084328463998523}
{"event": "sql_result", "rows_returned": 1, "returned_ids": ["module:fx05-l1-000", "module:fx05-l8-006"], "order": 1788084328464912466}
{"event": "sql_statement", "query_text": "\nWITH RECURSIVE depends_on_pkg(module_id) AS (\n  SELECT subject_id FROM module_depends_on_package WHERE object_id = 'package:fx05-legacy'\n  UNION\n  SELECT mdm.subject_id\n  FROM module_depends_on_module mdm\n  JOIN depends_on_pkg dop ON mdm.object_id = dop.module_id\n)\nSELECT module_id FROM depends_on_pkg ORDER BY module_id LIMIT 20\n", "parameters": "()", "order": 1788084328464983991}
{"event": "sql_result", "rows_returned": 20, "returned_ids": ["module:fx05-l1-000", "module:fx05-l1-001", "module:fx05-l1-002", "module:fx05-l1-003", "module:fx05-l1-004", "module:fx05-l1-005", "module:fx05-l1-006", "module:fx05-l2-000", "module:fx05-l2-001", "module:fx05-l2-002", "module:fx05-l2-003", "module:fx05-l2-004", "module:fx05-l2-005", "module:fx05-l2-006", "module:fx05-l2-007", "module:fx05-l2-008", "module:fx05-l2-009", "module:fx05-l2-010", "module:fx05-l2-011", "module:fx05-l2-012"], "order": 1788084328465450065}
{"event": "sql_statement", "query_text": "\nWITH RECURSIVE chain(module_id, depth) AS (\n  SELECT 'module:fx05-l8-000', 0\n  UNION ALL\n  SELECT mdm.object_id, c.depth + 1\n  FROM chain c\n  JOIN module_depends_on_module mdm ON mdm.subject_id = c.module_id\n  WHERE c.depth < 20\n)\nSELECT * FROM chain WHERE module_id LIKE 'module:fx05-l1%' OR module_id = 'package:fx05-legacy' OR depth <= 3\nORDER BY depth\n", "parameters": "()", "order": 1788084328465509439}
