{"event": "sql_statement", "query_text": "\nSELECT DISTINCT sim.subject_id\nFROM service_implements_module sim\nJOIN module_depends_on_package mdp ON mdp.subject_id = sim.object_id AND mdp.object_id = 'package:fx05-legacy'\nJOIN service_deployed_to_deployment sdd ON sdd.subject_id = sim.subject_id\nWHERE sdd.object_id = 'deployment:fx05-production'\nORDER BY sim.subject_id\n", "parameters": "()", "order": 1788084338320952178}
{"event": "sql_result", "rows_returned": 0, "returned_ids": [], "order": 1788084338321493572}
{"event": "sql_statement", "query_text": "\nSELECT DISTINCT d.id\nFROM deployments d\nJOIN service_deployed_to_deployment sdd ON sdd.object_id = d.id\nJOIN service_implements_module sim ON sim.subject_id = sdd.subject_id\nJOIN (\n  WITH RECURSIVE depends_on_pkg(module_id) AS (\n    SELECT subject_id FROM module_depends_on_package WHERE object_id = 'package:fx05-legacy'\n    UNION\n    SELECT mdm.subject_id FROM module_depends_on_module mdm\n    JOIN depends_on_pkg dop ON mdm.object_id = dop.module_id\n  )\n  SELECT module_id FROM depends_on_pkg\n) pkg_mods ON pkg_mods.module_id = sim.object_id\nJOIN package_affects_migration pam ON pam.subject_id = 'package:fx05-legacy'\nJOIN migration_targets_deployment mtd ON mtd.subject_id = pam.object_id AND mtd.object_id = d.id\nORDER BY d.id\n", "parameters": "()", "order": 1788084338321555308}
{"event": "sql_result", "rows_returned": 1, "returned_ids": ["deployment:fx05-production"], "order": 1788084338322242683}
{"event": "sql_statement", "query_text": "\nSELECT DISTINCT sim.subject_id\nFROM service_implements_module sim\nJOIN service_deployed_to_deployment sdd ON sdd.subject_id = sim.subject_id\nJOIN deployments d ON d.id = sdd.object_id AND d.label = 'Production'\nJOIN (\n  WITH RECURSIVE depends_on_pkg(module_id) AS (\n    SELECT subject_id FROM module_depends_on_package WHERE object_id = 'package:fx05-legacy'\n    UNION\n    SELECT mdm.subject_id FROM module_depends_on_module mdm\n    JOIN depends_on_pkg dop ON mdm.object_id = dop.module_id\n  )\n  SELECT module_id FROM depends_on_pkg\n) pkg_mods ON pkg_mods.module_id = sim.object_id\nJOIN package_affects_migration pam ON pam.subject_id = 'package:fx05-legacy'\nJOIN migration_targets_deployment mtd ON mtd.subject_id = pam.object_id AND mtd.object_id = sdd.object_id\nORDER BY sim.subject_id\n", "parameters": "()", "order": 1788084338322302742}
{"event": "sql_result", "rows_returned": 6, "returned_ids": ["service:fx05-00", "service:fx05-01", "service:fx05-02", "service:fx05-03", "service:fx05-04", "service:fx05-05"], "order": 1788084338322865312}
{"event": "sql_statement", "query_text": "\nSELECT * FROM task_retires_package trp\nJOIN package_affects_migration pam ON pam.subject_id = trp.object_id\nJOIN migration_targets_deployment mtd ON mtd.subject_id = pam.object_id\nJOIN task_targets_deployment ttd ON ttd.subject_id = trp.subject_id AND ttd.object_id = mtd.object_id\nWHERE trp.subject_id = 'task:fx05-cutover'\n", "parameters": "()", "order": 1788084338322912990}
