{"event": "sql_statement", "query_text": "\nWITH RECURSIVE affected_modules(module_id) AS (\n  SELECT subject_id FROM module_depends_on_package WHERE object_id = 'package:fx01-legacy'\n  UNION\n  SELECT m.subject_id\n  FROM module_depends_on_module m\n  JOIN affected_modules a ON m.object_id = a.module_id\n),\nproduction_services AS (\n  SELECT s.subject_id AS service_id\n  FROM service_deployed_to_deployment s\n  JOIN task_targets_deployment t ON t.object_id = s.object_id\n  WHERE t.subject_id = 'task:fx01-cutover'\n)\nSELECT DISTINCT sim.subject_id AS service_id\nFROM service_implements_module sim\nJOIN affected_modules am ON sim.object_id = am.module_id\nJOIN production_services ps ON ps.service_id = sim.subject_id\nORDER BY service_id\n", "parameters": "()", "order": 1788081125805215792}
