{"event": "sql_statement", "query_text": "\nSELECT DISTINCT sd.object_id AS deployment_id\nFROM service_deployed_to_deployment sd\nJOIN service_implements_module sim ON sd.subject_id = sim.subject_id\nJOIN (\n    WITH RECURSIVE legacy_modules(module_id) AS (\n        SELECT subject_id FROM module_depends_on_package WHERE object_id = 'package:fx05-legacy'\n        UNION\n        SELECT mdm.subject_id FROM module_depends_on_module mdm\n        JOIN legacy_modules lm ON mdm.object_id = lm.module_id\n    )\n    SELECT module_id FROM legacy_modules\n) lm ON sim.object_id = lm.module_id\nJOIN package_affects_migration pam ON pam.subject_id = 'package:fx05-legacy'\nJOIN migration_targets_deployment mtd ON mtd.subject_id = pam.object_id AND mtd.object_id = sd.object_id\nORDER BY deployment_id\n", "parameters": "()", "order": 1788081786437734866}
