{"event": "sql_statement", "query_text": "SELECT subject_id, object_id FROM service_implements_module", "parameters": "()", "order": 1788081735833405056}
{"event": "sql_statement", "query_text": "\nWITH RECURSIVE affected_modules(module_id) AS (\n  SELECT subject_id FROM module_depends_on_package WHERE object_id = 'package:fx04-legacy'\n  UNION\n  SELECT mdm.subject_id\n  FROM module_depends_on_module mdm\n  JOIN affected_modules am ON mdm.object_id = am.module_id\n)\nSELECT DISTINCT s.id AS service_id\nFROM services s\nJOIN service_implements_module sim ON sim.subject_id = s.id\nJOIN affected_modules am ON sim.object_id = am.module_id\nJOIN service_deployed_to_deployment sdd ON sdd.subject_id = s.id\nWHERE sdd.object_id = 'deployment:fx04-production'\nORDER BY s.id\n", "parameters": "()", "order": 1788081740404194312}
{"event": "sql_result", "rows_returned": 5, "returned_ids": [], "order": 1788081740405078535}
{"event": "sql_statement", "query_text": "\nWITH RECURSIVE affected_modules(module_id) AS (\n  SELECT subject_id FROM module_depends_on_package WHERE object_id = 'package:fx04-legacy'\n  UNION\n  SELECT mdm.subject_id\n  FROM module_depends_on_module mdm\n  JOIN affected_modules am ON mdm.object_id = am.module_id\n)\nSELECT DISTINCT s.id AS service_id\nFROM services s\nJOIN service_implements_module sim ON sim.subject_id = s.id\nJOIN affected_modules am ON sim.object_id = am.module_id\nJOIN service_deployed_to_deployment sdd ON sdd.subject_id = s.id\nWHERE sdd.object_id = 'deployment:fx04-production'\nAND s.id NOT IN (\n  SELECT subject_id FROM service_crosses_deprecated_boundary\n)\nORDER BY s.id\n", "parameters": "()", "order": 1788081740405182489}
