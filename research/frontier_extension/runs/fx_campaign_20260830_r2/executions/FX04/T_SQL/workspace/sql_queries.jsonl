{"event": "sql_statement", "query_text": "\nWITH RECURSIVE affected_modules(module_id) AS (\n  SELECT mdp.subject_id\n  FROM task_retires_package trp\n  JOIN package_affects_migration pam ON pam.subject_id = trp.object_id\n  JOIN module_depends_on_package mdp ON mdp.object_id = trp.object_id\n  WHERE trp.subject_id = 'task:fx04-cutover'\n  UNION\n  SELECT mdm.subject_id\n  FROM module_depends_on_module mdm\n  JOIN affected_modules am ON mdm.object_id = am.module_id\n)\nSELECT DISTINCT s.id\nFROM tasks t\nJOIN task_targets_deployment ttd ON ttd.subject_id = t.id\nJOIN migration_targets_deployment mtd ON mtd.object_id = ttd.object_id\nJOIN package_affects_migration pam ON pam.object_id = mtd.subject_id\n  AND pam.subject_id IN (\n    SELECT object_id FROM task_retires_package WHERE subject_id = t.id\n  )\nJOIN service_deployed_to_deployment sdd ON sdd.object_id = ttd.object_id\nJOIN services s ON s.id = sdd.subject_id\nJOIN service_implements_module sim ON sim.subject_id = s.id\nJOIN affected_modules am ON am.module_id = sim.object_id\nWHERE t.id = 'task:fx04-cutover'\n  AND NOT EXISTS (\n    SELECT 1 FROM service_crosses_deprecated_boundary scdb\n    WHERE scdb.subject_id = s.id\n  )\nORDER BY s.id\n", "parameters": "()", "order": 1788081754377881424}
