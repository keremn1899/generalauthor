{"event": "sql_statement", "query_text": "\nSELECT t.id, t.label\nFROM tests t\nJOIN test_verifies_service tvs ON tvs.subject_id = t.id\nJOIN services s ON s.id = tvs.object_id\nJOIN service_deployed_to_deployment sdt ON sdt.subject_id = s.id\nJOIN deployments d ON d.id = sdt.object_id\nWHERE s.id = 'service:telemetry-api'\n  AND d.id = 'deployment:production'\n", "parameters": "()", "order": 1788045079551989381}
