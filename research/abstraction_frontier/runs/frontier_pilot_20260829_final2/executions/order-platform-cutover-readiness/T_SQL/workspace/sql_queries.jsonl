{"event": "sql_statement", "query_text": "\nWITH retiring AS (\n    SELECT trp.object_id AS package_id\n    FROM task_retires_package trp\n    JOIN tasks t ON t.id = trp.subject_id\n    WHERE t.label LIKE '%legacy%cutover%' OR t.id LIKE '%legacy-cutover%'\n),\naffected_modules AS (\n    -- modules directly depending on retiring package\n    SELECT mdp.subject_id AS module_id\n    FROM module_depends_on_package mdp\n    WHERE mdp.object_id IN (SELECT package_id FROM retiring)\n    UNION\n    -- transitive module dependencies\n    SELECT mdm.subject_id AS module_id\n    FROM module_depends_on_module mdm\n    JOIN affected_modules am ON mdm.object_id = am.module_id\n),\naffected_services AS (\n    SELECT DISTINCT sim.subject_id AS service_id\n    FROM service_implements_module sim\n    WHERE sim.object_id IN (SELECT module_id FROM affected_modules)\n),\nproduction_services AS (\n    SELECT sdt.subject_id AS service_id\n    FROM service_deployed_to_deployment sdt\n  JOIN deployments d ON d.id = sdt.object_id\n    WHERE d.label = 'Production' OR d.id = 'deployment:production'\n)\nSELECT s.id, s.label\nFROM services s\nWHERE s.id IN (SELECT service_id FROM affected_services)\n  AND s.id IN (SELECT service_id FROM production_services)\nORDER BY s.id\n", "parameters": "()", "order": 1788043617102052813}
{"event": "sql_result", "rows_returned": 2, "returned_ids": ["service:fulfilment-worker", "service:order-api"], "order": 1788043617102708883}
{"event": "sql_statement", "query_text": "\nWITH retiring AS (\n    SELECT trp.object_id AS package_id\n    FROM task_retires_package trp\n    JOIN tasks t ON t.id = trp.subject_id\n    WHERE t.label LIKE '%legacy%cutover%' OR t.id LIKE '%legacy-cutover%'\n),\naffected_modules AS (\n    SELECT mdp.subject_id AS module_id\n    FROM module_depends_on_package mdp\n    WHERE mdp.object_id IN (SELECT package_id FROM retiring)\n    UNION\n    SELECT mdm.subject_id AS module_id\n    FROM module_depends_on_module mdm\n    JOIN affected_modules am ON mdm.object_id = am.module_id\n),\naffected_services AS (\n    SELECT DISTINCT sim.subject_id AS service_id\n    FROM service_implements_module sim\n    WHERE sim.object_id IN (SELECT module_id FROM affected_modules)\n),\nproduction_services AS (\n    SELECT sdt.subject_id AS service_id\n    FROM service_deployed_to_deployment sdt\n    JOIN deployments d ON d.id = sdt.object_id\n    WHERE d.label = 'Production' OR d.id = 'deployment:production'\n)\nSELECT DISTINCT t.id, t.label\nFROM tests t\nJOIN test_verifies_service tvs ON tvs.subject_id = t.id\nWHERE tvs.object_id IN (\n    SELECT service_id FROM affected_services\n    INTERSECT\n    SELECT service_id FROM production_services\n)\nORDER BY t.id\n", "parameters": "()", "order": 1788043617102752872}
{"event": "sql_result", "rows_returned": 2, "returned_ids": ["test:order-platform-api-contract", "test:order-platform-worker-integration"], "order": 1788043617103111717}
