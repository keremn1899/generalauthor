{"event": "sql_statement", "query_text": "\nWITH RECURSIVE affected_modules(id) AS (\n    -- modules that directly depend on legacy-crypto package\n    SELECT subject_id AS id\n    FROM module_depends_on_package\n    WHERE object_id = 'package:legacy-crypto'\n    \n    UNION\n    \n    -- modules that depend on affected modules\n    SELECT mdm.subject_id\n    FROM module_depends_on_module mdm\n    JOIN affected_modules am ON mdm.object_id = am.id\n),\naffected_services AS (\n    SELECT DISTINCT sim.subject_id AS service_id\n    FROM service_implements_module sim\n    JOIN affected_modules am ON sim.object_id = am.id\n),\nproduction_services AS (\n    SELECT DISTINCT sdt.subject_id AS service_id\n    FROM service_deployed_to_deployment sdt\n    WHERE sdt.object_id = 'deployment:production'\n)\nSELECT ps.service_id\nFROM production_services ps\nJOIN affected_services asv ON ps.service_id = asv.service_id\nORDER BY ps.service_id\n", "parameters": "()", "order": 1788043958892458940}
{"event": "sql_result", "rows_returned": 2, "returned_ids": ["service:identity-api", "service:session-worker"], "order": 1788043958892938589}
