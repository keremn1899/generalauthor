{"event": "sql_statement", "query_text": "\nWITH cutover AS (\n  SELECT t.id AS task_id, td.object_id AS deployment_id, tr.object_id AS package_id\n  FROM tasks t\n  JOIN task_targets_deployment td ON td.subject_id = t.id\n  JOIN task_retires_package tr ON tr.subject_id = t.id\n  WHERE t.id = 'task:catalogue-platform-legacy-cutover'\n),\naffected_modules AS (\n  SELECT mdp.subject_id AS module_id\n  FROM cutover c\n  JOIN module_depends_on_package mdp ON mdp.object_id = c.package_id\n  UNION\n  SELECT mdm.subject_id AS module_id\n  FROM cutover c\n  JOIN module_depends_on_package mdp ON mdp.object_id = c.package_id\n  JOIN module_depends_on_module mdm ON mdm.object_id = mdp.subject_id\n),\nin_scope_services AS (\n  SELECT DISTINCT sim.subject_id AS service_id\n  FROM affected_modules am\n  JOIN service_implements_module sim ON sim.object_id = am.module_id\n  JOIN cutover c ON 1=1\n  JOIN service_deployed_to_deployment sdt ON sdt.subject_id = sim.subject_id\n    AND sdt.object_id = c.deployment_id\n),\nproduction_api AS (\n  SELECT iss.service_id\n  FROM in_scope_services iss\n  JOIN services s ON s.id = iss.service_id\n  WHERE s.label LIKE '%api%' OR s.id LIKE '%api%'\n)\nSELECT scb.object_id AS boundary_id\nFROM production_api pa\nJOIN service_crosses_boundary scb ON scb.subject_id = pa.service_id\n", "parameters": "()", "order": 1788044752926214682}
{"event": "sql_result", "rows_returned": 1, "returned_ids": ["boundary:catalogue-platform-public"], "order": 1788044752927099012}
{"event": "sql_statement", "query_text": "\nSELECT s.id, s.label, scb.object_id\nFROM services s\nJOIN service_crosses_boundary scb ON scb.subject_id = s.id\nJOIN service_deployed_to_deployment sdt ON sdt.subject_id = s.id\nWHERE sdt.object_id = 'deployment:production'\n", "parameters": "()", "order": 1788044752927147151}
{"event": "sql_result", "rows_returned": 2, "returned_ids": ["service:catalogue-api", "boundary:catalogue-platform-public", "service:index-worker", "boundary:catalogue-platform-restricted"], "order": 1788044752927204742}
