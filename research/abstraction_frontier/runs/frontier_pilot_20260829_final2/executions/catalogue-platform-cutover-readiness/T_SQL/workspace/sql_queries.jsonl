{"event": "sql_statement", "query_text": "\nWITH retiring AS (\n    SELECT trp.object_id AS package_id\n    FROM task_retires_package trp\n    JOIN tasks t ON t.id = trp.subject_id\n    WHERE t.id = 'task:catalogue-platform-legacy-cutover'\n),\nproduction AS (\n    SELECT ttd.object_id AS deployment_id\n    FROM task_targets_deployment ttd\n    JOIN tasks t ON t.id = ttd.subject_id\n    WHERE t.id = 'task:catalogue-platform-legacy-cutover'\n),\naffected_modules AS (\n    -- modules that directly depend on retiring package\n    SELECT mdp.subject_id AS module_id\n    FROM module_depends_on_package mdp\n    JOIN retiring r ON r.package_id = mdp.object_id\n    UNION\n    -- modules that transitively depend via module_depends_on_module\n    SELECT mdm.subject_id AS module_id\n    FROM module_depends_on_module mdm\n    JOIN affected_modules am ON mdm.object_id = am.module_id\n),\naffected_services AS (\n    SELECT DISTINCT sim.subject_id AS service_id\n    FROM service_implements_module sim\n    JOIN affected_modules am ON am.module_id = sim.object_id\n    JOIN service_deployed_to_deployment sdt ON sdt.subject_id = sim.subject_id\n    JOIN production p ON p.deployment_id = sdt.object_id\n)\nSELECT service_id FROM affected_services ORDER BY service_id\n", "parameters": "()", "order": 1788044918907205776}
{"event": "sql_result", "rows_returned": 2, "returned_ids": ["service:catalogue-api", "service:index-worker"], "order": 1788044918907718613}
{"event": "sql_statement", "query_text": "\nWITH retiring AS (\n    SELECT trp.object_id AS package_id\n    FROM task_retires_package trp\n    JOIN tasks t ON t.id = trp.subject_id\n    WHERE t.id = 'task:catalogue-platform-legacy-cutover'\n),\nproduction AS (\n    SELECT ttd.object_id AS deployment_id\n    FROM task_targets_deployment ttd\n    JOIN tasks t ON t.id = ttd.subject_id\n    WHERE t.id = 'task:catalogue-platform-legacy-cutover'\n),\naffected_modules AS (\n    SELECT mdp.subject_id AS module_id\n    FROM module_depends_on_package mdp\n    JOIN retiring r ON r.package_id = mdp.object_id\n    UNION\n    SELECT mdm.subject_id AS module_id\n    FROM module_depends_on_module mdm\n    JOIN affected_modules am ON mdm.object_id = am.module_id\n),\naffected_services AS (\n    SELECT DISTINCT sim.subject_id AS service_id\n    FROM service_implements_module sim\n    JOIN affected_modules am ON am.module_id = sim.object_id\n    JOIN service_deployed_to_deployment sdt ON sdt.subject_id = sim.subject_id\n    JOIN production p ON p.deployment_id = sdt.object_id\n)\nSELECT DISTINCT tvs.subject_id AS test_id\nFROM test_verifies_service tvs\nJOIN affected_services a ON a.service_id = tvs.object_id\nORDER BY test_id\n", "parameters": "()", "order": 1788044918907758346}
{"event": "sql_result", "rows_returned": 2, "returned_ids": ["test:catalogue-platform-api-contract", "test:catalogue-platform-worker-integration"], "order": 1788044918907961256}
