{"event": "sql_statement", "query_text": "\nWITH RECURSIVE retiring AS (\n  SELECT trp.object_id AS package_id\n  FROM task_retires_package trp\n  JOIN tasks t ON t.id = trp.subject_id\n  WHERE t.label LIKE '%legacy%cutover%' OR t.id LIKE '%legacy-cutover%'\n),\ntarget_deployment AS (\n  SELECT ttd.object_id AS deployment_id\n  FROM task_targets_deployment ttd\n  JOIN tasks t ON t.id = ttd.subject_id\n  WHERE t.label LIKE '%legacy%cutover%' OR t.id LIKE '%legacy-cutover%'\n),\naffected_modules AS (\n  SELECT mdp.subject_id AS module_id\n  FROM module_depends_on_package mdp\n  JOIN retiring r ON r.package_id = mdp.object_id\n  UNION\n  SELECT mdm.subject_id AS module_id\n  FROM module_depends_on_module mdm\n  JOIN affected_modules am ON am.module_id = mdm.object_id\n)\nSELECT DISTINCT s.id\nFROM services s\nJOIN service_implements_module sim ON sim.subject_id = s.id\nJOIN affected_modules am ON am.module_id = sim.object_id\nJOIN service_deployed_to_deployment sdd ON sdd.subject_id = s.id\nJOIN target_deployment td ON td.deployment_id = sdd.object_id\nORDER BY s.id\n", "parameters": "()", "order": 1788045653944911400}
{"event": "sql_statement", "query_text": "\nWITH RECURSIVE retiring AS (\n  SELECT trp.object_id AS package_id\n  FROM task_retires_package trp\n  JOIN tasks t ON t.id = trp.subject_id\n  WHERE t.label LIKE '%legacy%cutover%' OR t.id LIKE '%legacy-cutover%'\n),\ntarget_deployment AS (\n  SELECT ttd.object_id AS deployment_id\n  FROM task_targets_deployment ttd\n  JOIN tasks t ON t.id = ttd.subject_id\n  WHERE t.label LIKE '%legacy%cutover%' OR t.id LIKE '%legacy-cutover%'\n),\naffected_modules AS (\n  SELECT mdp.subject_id AS module_id\n  FROM module_depends_on_package mdp\n  JOIN retiring r ON r.package_id = mdp.object_id\n  UNION\n  SELECT mdm.subject_id AS module_id\n  FROM module_depends_on_module mdm\n  JOIN affected_modules am ON am.module_id = mdm.object_id\n),\naffected_services AS (\n  SELECT DISTINCT s.id AS service_id\n  FROM services s\n  JOIN service_implements_module sim ON sim.subject_id = s.id\n  JOIN affected_modules am ON am.module_id = sim.object_id\n  JOIN service_deployed_to_deployment sdd ON sdd.subject_id = s.id\n  JOIN target_deployment td ON td.deployment_id = sdd.object_id\n)\nSELECT DISTINCT t.id\nFROM tests t\nJOIN test_verifies_service tvs ON tvs.subject_id = t.id\nJOIN affected_services a ON a.service_id = tvs.object_id\nORDER BY t.id\n", "parameters": "()", "order": 1788045653945382419}
