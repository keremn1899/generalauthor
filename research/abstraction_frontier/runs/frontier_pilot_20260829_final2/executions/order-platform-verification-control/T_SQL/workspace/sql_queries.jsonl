{"event": "sql_statement", "query_text": "\nSELECT t.id, t.label\nFROM services s\nJOIN service_deployed_to_deployment sd ON sd.subject_id = s.id\nJOIN deployments d ON d.id = sd.object_id\nJOIN test_verifies_service tvs ON tvs.object_id = s.id\nJOIN tests t ON t.id = tvs.subject_id\nWHERE s.label LIKE '%api%' AND d.label = 'Production'\n", "parameters": "()", "order": 1788043085131743675}
