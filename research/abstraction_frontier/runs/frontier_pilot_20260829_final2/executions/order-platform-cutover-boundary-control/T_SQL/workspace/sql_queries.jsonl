{"event": "sql_statement", "query_text": "\nWITH cutover AS (\n  SELECT t.id AS task_id, t.label AS task_label\n  FROM tasks t\n  WHERE t.id = 'task:order-platform-legacy-cutover'\n),\nproduction_deployment AS (\n  SELECT ttd.object_id AS deployment_id\n  FROM task_targets_deployment ttd\n  JOIN cutover c ON c.task_id = ttd.subject_id\n),\nproduction_services AS (\n  SELECT s.id AS service_id, s.label AS service_label\n  FROM services s\n  JOIN service_deployed_to_deployment sd ON sd.subject_id = s.id\n  JOIN production_deployment pd ON pd.deployment_id = sd.object_id\n),\napi_service AS (\n  SELECT ps.service_id, ps.service_label\n  FROM production_services ps\n  JOIN test_verifies_service tvs ON tvs.object_id = ps.service_id\n  JOIN tests t ON t.id = tvs.subject_id\n  WHERE t.label LIKE '%API%'\n)\nSELECT scb.object_id AS boundary_id, b.label AS boundary_label, a.service_id, a.service_label\nFROM api_service a\nJOIN service_crosses_boundary scb ON scb.subject_id = a.service_id\nJOIN boundarys b ON b.id = scb.object_id\n", "parameters": "()", "order": 1788043456097281805}
