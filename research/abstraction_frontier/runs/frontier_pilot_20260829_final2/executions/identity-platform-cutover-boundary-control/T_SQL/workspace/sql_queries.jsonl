{"event": "sql_statement", "query_text": "\nWITH cutover AS (\n  SELECT id FROM tasks WHERE id = 'task:identity-platform-legacy-cutover'\n),\nretired_packages AS (\n  SELECT trp.object_id AS package_id\n  FROM task_retires_package trp\n  JOIN cutover c ON trp.subject_id = c.id\n),\naffected_modules AS (\n  SELECT mdp.subject_id AS module_id\n  FROM module_depends_on_package mdp\n  JOIN retired_packages rp ON mdp.object_id = rp.package_id\n  UNION\n  SELECT mdm.subject_id AS module_id\n  FROM module_depends_on_module mdm\n  JOIN affected_modules am ON mdm.object_id = am.module_id\n),\nin_scope_services AS (\n  SELECT DISTINCT sim.subject_id AS service_id\n  FROM service_implements_module sim\n  JOIN affected_modules am ON sim.object_id = am.module_id\n),\nproduction_api AS (\n  SELECT s.id AS service_id, s.label\n  FROM services s\n  JOIN in_scope_services iss ON s.id = iss.service_id\n  JOIN service_deployed_to_deployment sdd ON s.id = sdd.subject_id\n  JOIN task_targets_deployment ttd ON sdd.object_id = ttd.object_id\n  JOIN cutover c ON ttd.subject_id = c.id\n  WHERE s.label LIKE '%api%' OR s.id LIKE '%api%'\n)\nSELECT pa.service_id, pa.label, scb.object_id AS boundary_id, b.label AS boundary_label\nFROM production_api pa\nJOIN service_crosses_boundary scb ON pa.service_id = scb.subject_id\nJOIN boundarys b ON scb.object_id = b.id\n", "parameters": "()", "order": 1788044120771609571}
{"event": "sql_statement", "query_text": "\nWITH RECURSIVE cutover AS (\n  SELECT id FROM tasks WHERE id = 'task:identity-platform-legacy-cutover'\n),\nretired_packages AS (\n  SELECT trp.object_id AS package_id\n  FROM task_retires_package trp\n  JOIN cutover c ON trp.subject_id = c.id\n),\naffected_modules AS (\n  SELECT mdp.subject_id AS module_id\n  FROM module_depends_on_package mdp\n  JOIN retired_packages rp ON mdp.object_id = rp.package_id\n  UNION\n  SELECT mdm.subject_id AS module_id\n  FROM module_depends_on_module mdm\n  JOIN affected_modules am ON mdm.object_id = am.module_id\n),\nin_scope_services AS (\n  SELECT DISTINCT sim.subject_id AS service_id\n  FROM service_implements_module sim\n  JOIN affected_modules am ON sim.object_id = am.module_id\n),\nproduction_services AS (\n  SELECT s.id AS service_id, s.label\n  FROM services s\n  JOIN in_scope_services iss ON s.id = iss.service_id\n  JOIN service_deployed_to_deployment sdd ON s.id = sdd.subject_id\n  JOIN task_targets_deployment ttd ON sdd.object_id = ttd.object_id\n  JOIN cutover c ON ttd.subject_id = c.id\n)\nSELECT ps.service_id, ps.label, scb.object_id AS boundary_id, b.label AS boundary_label\nFROM production_services ps\nJOIN service_crosses_boundary scb ON ps.service_id = scb.subject_id\nJOIN boundarys b ON scb.object_id = b.id\n", "parameters": "()", "order": 1788044120772197440}
