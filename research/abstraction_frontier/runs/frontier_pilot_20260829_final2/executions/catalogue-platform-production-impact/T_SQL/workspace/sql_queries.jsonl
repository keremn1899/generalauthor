{"event": "sql_statement", "query_text": "\nWITH RECURSIVE affected_modules AS (\n    -- modules that directly depend on legacy-search package\n    SELECT subject_id AS module_id\n    FROM module_depends_on_package\n    WHERE object_id = 'package:legacy-search'\n    \n    UNION\n    \n    -- modules that depend on affected modules\n    SELECT mdm.subject_id\n    FROM module_depends_on_module mdm\n    JOIN affected_modules am ON mdm.object_id = am.module_id\n)\nSELECT * FROM affected_modules;\n", "parameters": "()", "order": 1788044578442594111}
{"event": "sql_result", "rows_returned": 2, "returned_ids": ["module:catalogue-core", "module:catalogue-gateway"], "order": 1788044578442935923}
{"event": "sql_statement", "query_text": "\nWITH RECURSIVE affected_modules AS (\n    SELECT subject_id AS module_id\n    FROM module_depends_on_package\n    WHERE object_id = 'package:legacy-search'\n    UNION\n    SELECT mdm.subject_id\n    FROM module_depends_on_module mdm\n    JOIN affected_modules am ON mdm.object_id = am.module_id\n)\nSELECT DISTINCT sim.subject_id AS service_id\nFROM service_implements_module sim\nJOIN affected_modules am ON sim.object_id = am.module_id\nJOIN service_deployed_to_deployment sdt ON sim.subject_id = sdt.subject_id\nWHERE sdt.object_id = 'deployment:production'\nORDER BY service_id;\n", "parameters": "()", "order": 1788044578442977520}
{"event": "sql_result", "rows_returned": 2, "returned_ids": ["service:catalogue-api", "service:index-worker"], "order": 1788044578443126608}
