{"event": "sql_statement", "query_text": "\nWITH RECURSIVE retiring AS (\n  SELECT trp.object_id AS package_id,\n         ttd.object_id AS deployment_id\n  FROM task_retires_package trp\n  JOIN task_targets_deployment ttd ON ttd.subject_id = trp.subject_id\n  WHERE trp.subject_id = 'task:identity-platform-legacy-cutover'\n),\npackage_modules AS (\n  SELECT mdop.subject_id AS module_id\n  FROM module_depends_on_package mdop\n  JOIN retiring r ON mdop.object_id = r.package_id\n),\nmodule_closure AS (\n  SELECT module_id FROM package_modules\n  UNION\n  SELECT mdom.subject_id AS module_id\n  FROM module_depends_on_module mdom\n  JOIN module_closure mc ON mdom.object_id = mc.module_id\n)\nSELECT DISTINCT sim.subject_id AS service_id\nFROM service_implements_module sim\nJOIN module_closure mc ON sim.object_id = mc.module_id\nJOIN service_deployed_to_deployment sdd ON sdd.subject_id = sim.subject_id\nJOIN retiring r ON sdd.object_id = r.deployment_id\nORDER BY service_id\n", "parameters": "()", "order": 1788044280515611300}
{"event": "sql_statement", "query_text": "\nWITH RECURSIVE retiring AS (\n  SELECT trp.object_id AS package_id,\n         ttd.object_id AS deployment_id\n  FROM task_retires_package trp\n  JOIN task_targets_deployment ttd ON ttd.subject_id = trp.subject_id\n  WHERE trp.subject_id = 'task:identity-platform-legacy-cutover'\n),\npackage_modules AS (\n  SELECT mdop.subject_id AS module_id\n  FROM module_depends_on_package mdop\n  JOIN retiring r ON mdop.object_id = r.package_id\n),\nmodule_closure AS (\n  SELECT module_id FROM package_modules\n  UNION\n  SELECT mdom.subject_id AS module_id\n  FROM module_depends_on_module mdom\n  JOIN module_closure mc ON mdom.object_id = mc.module_id\n),\naffected_services AS (\n  SELECT DISTINCT sim.subject_id AS service_id\n  FROM service_implements_module sim\n  JOIN module_closure mc ON sim.object_id = mc.module_id\n  JOIN service_deployed_to_deployment sdd ON sdd.subject_id = sim.subject_id\n  JOIN retiring r ON sdd.object_id = r.deployment_id\n)\nSELECT DISTINCT tvs.subject_id AS test_id\nFROM test_verifies_service tvs\nJOIN affected_services a ON tvs.object_id = a.service_id\nORDER BY test_id\n", "parameters": "()", "order": 1788044280516034536}
