{"event": "sql_statement", "query_text": "\nWITH RECURSIVE affected_modules(module_id) AS (\n  -- modules that directly depend on legacy-collector package\n  SELECT subject_id\n  FROM module_depends_on_package\n  WHERE object_id = 'package:legacy-collector'\n  UNION\n  -- modules that depend on already-affected modules\n  SELECT mdm.subject_id\n  FROM module_depends_on_module mdm\n  JOIN affected_modules am ON mdm.object_id = am.module_id\n),\naffected_services AS (\n  SELECT DISTINCT sim.subject_id AS service_id\n  FROM service_implements_module sim\n  JOIN affected_modules am ON sim.object_id = am.module_id\n),\nproduction_services AS (\n  SELECT subject_id AS service_id\n  FROM service_deployed_to_deployment\n  WHERE object_id = 'deployment:production'\n)\nSELECT ps.service_id\nFROM production_services ps\nJOIN affected_services af ON ps.service_id = af.service_id\nORDER BY ps.service_id\n", "parameters": "()", "order": 1788045346713479276}
