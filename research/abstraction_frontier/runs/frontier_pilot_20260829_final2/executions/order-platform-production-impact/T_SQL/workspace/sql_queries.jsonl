{"event": "sql_statement", "query_text": "\nWITH RECURSIVE affected_modules(module_id) AS (\n  SELECT subject_id AS module_id\n  FROM module_depends_on_package\n  WHERE object_id = 'package:legacy-money'\n  UNION\n  SELECT mdm.subject_id\n  FROM module_depends_on_module mdm\n  JOIN affected_modules am ON mdm.object_id = am.module_id\n)\nSELECT DISTINCT sim.subject_id AS service_id\nFROM service_implements_module sim\nJOIN affected_modules am ON sim.object_id = am.module_id\nJOIN service_deployed_to_deployment sd ON sd.subject_id = sim.subject_id\nJOIN deployments d ON sd.object_id = d.id\nWHERE d.label = 'Production'\nORDER BY service_id\n", "parameters": "()", "order": 1788043288295116692}
{"event": "sql_result", "rows_returned": 2, "returned_ids": ["service:fulfilment-worker", "service:order-api"], "order": 1788043288295909871}
