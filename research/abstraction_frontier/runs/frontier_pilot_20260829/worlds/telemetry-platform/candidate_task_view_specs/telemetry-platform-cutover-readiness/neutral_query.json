{
  "answers": [
    "affected",
    "covered"
  ],
  "derive": {
    "affected": {
      "inputs": [
        "$services",
        "$prod"
      ],
      "op": "intersection"
    },
    "covered": {
      "endpoint_kind": "test",
      "from": "$affected",
      "max_depth": 1,
      "op": "reverse_reachable",
      "predicates": [
        "verifies"
      ]
    },
    "cutover": {
      "op": "resolve",
      "references": "task:telemetry-platform-legacy-cutover"
    },
    "legacy": {
      "endpoint_kind": "package",
      "from": "$cutover",
      "max_depth": 1,
      "op": "traverse",
      "predicates": [
        "retires"
      ]
    },
    "modules": {
      "endpoint_kind": "module",
      "from": "$legacy",
      "max_depth": 2,
      "op": "reverse_reachable",
      "predicates": [
        "depends_on"
      ]
    },
    "prod": {
      "endpoint_kind": "service",
      "from": "deployment:production",
      "max_depth": 1,
      "op": "reverse_reachable",
      "predicates": [
        "deployed_to"
      ]
    },
    "services": {
      "endpoint_kind": "service",
      "from": "$modules",
      "max_depth": 1,
      "op": "reverse_reachable",
      "predicates": [
        "implements"
      ]
    }
  }
}
